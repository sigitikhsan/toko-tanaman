---
const tahun = new Date().getFullYear();
---

<footer class="bg-[#1E2923] text-[#F6F3EC] py-12">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pb-8 border-b border-[#F6F3EC]/10">
      <a href="/" class="text-2xl font-serif font-bold">TokoTanaman</a>
      
      <div class="flex gap-6">
        <a href="https://instagram.com" target="_blank" rel="noopener" class="text-sm hover:text-[#E07A5F] transition-colors">
          Instagram
        </a>
        <a href="https://facebook.com" target="_blank" rel="noopener" class="text-sm hover:text-[#E07A5F] transition-colors">
          Facebook
        </a>
        <a href="https://tiktok.com" target="_blank" rel="noopener" class="text-sm hover:text-[#E07A5F] transition-colors">
          TikTok
        </a>
      </div>
    </div>

    <div class="pt-8 text-center md:text-left">
      <p class="text-sm text-[#F6F3EC]/60">
        © {tahun} TokoTanaman. Semua hak dilindungi undang-undang.
      </p>
    </div>
  </div>
</footer>
