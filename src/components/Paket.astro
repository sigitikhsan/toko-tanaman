---
import { paket, formatRupiah, waLink } from '../data/paket';
---

<section id="paket" class="py-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-14 reveal-up">
      <span class="text-xs tracking-widest uppercase font-semibold text-[#E07A5F]">Koleksi 03 — Paket</span>
      <h2 class="text-4xl md:text-5xl font-serif mt-2 mb-4 text-[#1E2923]">Mulai dari satu pot,<br />atau isi satu sudut ruangan.</h2>
      <p class="text-[#1E2923]/70">Empat paket siap kirim. Semua sudah termasuk media tanam, pot, dan panduan perawatan.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 package-cards">
      {paket.map((p) => (
        <div
          class="flex flex-col bg-white border border-[#1E2923]/10 rounded-2xl p-6 transition-all duration-300 hover:shadow-lg hover:-translate-y-1 package-card"
        >
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-2xl font-serif text-[#1E2923]">{p.nama}</h3>
            {p.unggulan && (
              <span class="text-[#E07A5F]">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                </svg>
              </span>
            )}
          </div>
          <p class="text-sm text-[#1E2923]/70 mb-6">
            {p.deskripsi}
          </p>

          <p class="text-3xl font-serif text-[#1E2923] mb-1">{formatRupiah(p.harga)}</p>
          <p class="text-xs text-[#1E2923]/50 mb-6">
            untuk {p.cocokUntuk.toLowerCase()}
          </p>

          <ul class="space-y-2 text-sm mb-8 flex-1 text-[#1E2923]/80">
            {p.isi.map((item) => (
              <li class="flex gap-2">
                <span class="text-[#E07A5F]">—</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          <a
            href={waLink(p)}
            target="_blank"
            rel="noopener"
            class="text-center text-sm font-medium px-5 py-3 rounded-full bg-[#1E2923] text-white hover:bg-[#E07A5F] transition-colors"
          >
            Pesan Sekarang
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
