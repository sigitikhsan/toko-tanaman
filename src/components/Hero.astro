---
---

<section class="min-h-screen pt-32 pb-20 flex items-center">
  <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-center">
    <div class="reveal-left">
      <span class="text-xs tracking-widest uppercase font-semibold text-[#E07A5F] block mb-4">KOLEKSI 01</span>
      <h1 class="text-5xl md:text-7xl font-serif font-normal mb-6 leading-none">
        Bawa suasana alam ke dalam ruang Anda.
      </h1>
      <p class="text-lg text-[#1E2923]/80 mb-8 max-w-md">
        Tanaman hias pilihan yang dirawat dengan teliti. Sehat, segar, dan siap mempercantik sudut rumah atau meja kerja Anda.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="#paket" class="bg-[#1E2923] text-white px-6 py-3 rounded-full text-sm font-medium hover:bg-[#E07A5F] transition-colors">
          Lihat Paket
        </a>
        <a href="#produk" class="border border-[#1E2923]/30 px-6 py-3 rounded-full text-sm font-medium hover:border-[#1E2923] transition-colors">
          Jelajahi Koleksi
        </a>
      </div>
    </div>
    
    <div class="relative reveal-right">
      <div class="aspect-[4/5] bg-[#1E2923]/5 rounded-2xl overflow-hidden shadow-sm">
        <img 
          src="/images/hero.svg" 
          alt="Tanaman hias pilihan di dalam ruangan" 
          width="1000"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-sm hidden sm:block border border-[#1E2923]/10">
        <p class="text-xs text-[#1E2923]/60">Garansi Tanaman Sehat</p>
        <p class="text-sm font-serif font-bold">100% Penggantian Baru</p>
      </div>
    </div>
  </div>
</section>
